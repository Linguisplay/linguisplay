[Unit]
Description=LinguisPlay API (gated-RAG interactive fiction, port 8100)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/linguisplay/apps/api
EnvironmentFile=/opt/linguisplay/apps/api/.env
ExecStart=/opt/linguisplay/apps/api/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8100
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
